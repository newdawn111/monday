# Monday.com API Configuration for Solar Business Setup
# Copy this file to .env and fill in your actual values

# Get your API token from: https://monday.com/developers/v2/try-it-yourself
# Click on your profile (bottom left) -> Admin -> API
MONDAY_API_TOKEN=your_monday_api_token_here

# Workspace and Board Configuration
WORKSPACE_ID=5241558
LEADS_BOARD_ID=5084262112

# Optional: Custom Configuration
# API_ENDPOINT=https://api.monday.com/v2
# DELAY_BETWEEN_REQUESTS=500

# After running the setup script, your board IDs will be:
# SALES_PIPELINE_BOARD_ID=will_be_generated
# PROJECTS_BOARD_ID=will_be_generated
# FINANCIAL_BOARD_ID=will_be_generated

# ICount Integration (for future use)
# ICOUNT_API_KEY=your_icount_api_key
# ICOUNT_COMPANY_ID=your_company_id
